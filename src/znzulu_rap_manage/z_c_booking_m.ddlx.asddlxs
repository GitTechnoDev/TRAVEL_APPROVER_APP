@Metadata.layer: #CORE
@Search.searchable: true
@UI.headerInfo: {
    typeName: 'Booking',
    typeNamePlural: 'Bookings',
    title: {
        type: #STANDARD,
        label: 'Booking',
        value: 'BookingId'
    }
}
annotate view Z_C_BOOKING_M with
{
  @UI.facet: [{
      id: 'Booking',
      purpose: #STANDARD,
      position: 10,
      label: 'Booking',
      type:#IDENTIFICATION_REFERENCE

  },
  {
    id: 'BookingSuppl',
    purpose: #STANDARD,
    position: 20,
    label: 'Booking Supplemnts',
    type:#LINEITEM_REFERENCE,
    targetElement: '_Bookingsuppl'
  }]

  //    TravelId;
  @UI:{ lineItem: [{ position: 10, label: 'Booking Id' }],
                   identification: [{ position: 10, label: 'Booking Id' }] }
  @Search.defaultSearchElement: true
  BookingId;
  @UI:{ lineItem: [{ position: 20, label: 'Booking Date' }],
                   identification: [{ position: 20, label: 'Booking Date' }] }
  BookingDate;
  @UI:{ lineItem: [{ position: 30, label: 'Customer Id' }],
                   identification: [{ position: 30, label: 'Customer Id' }] }
  @Search.defaultSearchElement: true
  @Consumption.valueHelpDefinition: [{ entity: {
                                    name: '/DMO/I_Customer',
                                    element: 'CustomerID' } }]
  CustomerId;
  @UI:{ lineItem: [{ position: 40, label: 'Airline Id' }],
                    identification: [{ position: 40, label: 'Airline Id' }] }
  @Search.defaultSearchElement: true
  @Consumption.valueHelpDefinition: [{ entity: {
                                     name: '/DMO/I_Carrier',
                                    element: 'AirlineID' } }]
  CarrierId;
  @UI:{ lineItem: [{ position: 50, label: 'Flight Number' }],
                   identification: [{ position: 50, label: 'Flight Number' }] }
  @Search.defaultSearchElement: true
  @Consumption.valueHelpDefinition: [{ entity: {
                                     name: '/DMO/I_Flight',
                                    element: 'ConnectionID' },
                                    additionalBinding: [{ element: 'ConnectionID', localElement: 'ConnectionId' },// Filter Flight Number based on TravelID
                                                        { element: 'AirlineID', localElement: 'CarrierId' },
                                                        { element: 'CurrencyCode', localElement: 'CurrencyCode' },
                                                        { element: 'Price', localElement: 'FlightPrice' } ]                             
                                     }]
  ConnectionId;
  @UI:{ lineItem: [{ position: 60, label: 'Flight Date' }],
                    identification: [{ position: 60, label: 'Flight Date' }] }
   @Consumption.valueHelpDefinition: [{ entity: {
                                     name: '/DMO/I_Flight',
                                    element: 'FlightDate' },
                                    additionalBinding: [{ element: 'FlightDate', localElement: 'FlightDate' },// Filter Flight Number based on TravelID
                                                        { element: 'AirlineID', localElement: 'CarrierId' },
                                                        { element: 'CurrencyCode', localElement: 'CurrencyCode' },
                                                        { element: 'Price', localElement: 'FlightPrice' } ]                             
                                     }]
  FlightDate;
  @UI:{ lineItem: [{ position: 70, label: 'Flight Price' }],
                    identification: [{ position: 70, label: 'Flight Price' }] }
  FlightPrice;
  @UI:{ lineItem: [{ position: 80, label: 'Currency Code' }],
                    identification: [{ position: 80, label: 'Currency Code' }] }
  @Consumption.valueHelpDefinition: [{ entity: {
                                     name: 'I_Currency',
                                    element: 'Currency' } }]
  CurrencyCode;
  @UI:{ lineItem: [{ position: 90, label: 'Booking Status' }],
                    identification: [{ position: 90, label: 'Booking Status' }],
                    textArrangement: #TEXT_ONLY }
  @Consumption.valueHelpDefinition: [{ entity: {
                                     name: '/DMO/I_Booking_Status_VH',
                                    element: 'BookingStatus' } }]
  BookingStatus;
  @UI.hidden: true
  LastChangedAt;


}